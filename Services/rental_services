def return_vehicle(customer_id):
   
 
   rental_id = int(input("Enter Rental ID: "))
   query = """
   SELECT vehicle_id
   FROM rental
   WHERE rental_id=%s
   AND customer_id=%s
   AND rental_status='Active'
   """
   cursor.execute(query, (rental_id, customer_id))
   rental = cursor.fetchone()
   if rental is None:
    console.print("❌ Rental Record Not Found!", style="bold red")
    return
   vehicle_id = rental[0]
   today = datetime.today().strftime("%Y-%m-%d")
   cursor.execute("""
   UPDATE rental
   SET return_date=%s,
      rental_status='Completed'
    WHERE rental_id=%s
    """, (today, rental_id))
   cursor.execute("""
   UPDATE vehicle
   SET status='Available'
   WHERE vehicle_id=%s
   """, (vehicle_id,))
   conn.commit()
   console.print("✅ Vehicle Returned Successfully!", style="bold green")



